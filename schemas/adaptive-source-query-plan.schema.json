{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://statistikassistenten.local/schemas/source-query-plan-v2.schema.json",
  "title": "Source Query Plan v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "question",
    "status",
    "planning_mode",
    "information_needs",
    "source_roles",
    "combination",
    "decision"
  ],
  "properties": {
    "question": {"type": "string", "minLength": 1},
    "status": {
      "enum": ["ready", "needs_clarification", "needs_user_review", "blocked"]
    },
    "planning_mode": {
      "enum": ["direct", "review_before_execution"]
    },
    "information_needs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "measure", "concept", "population", "geography",
          "period", "frequency", "breakdowns", "comparison_mode", "derived"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "measure": {"type": "string", "minLength": 1},
          "concept": {"type": "string", "minLength": 1},
          "population": {"type": "string", "minLength": 1},
          "geography": {"type": "string", "minLength": 1},
          "period": {"type": "string", "minLength": 1},
          "frequency": {"type": "string", "minLength": 1},
          "breakdowns": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "comparison_mode": {
            "enum": [
              "single_value", "trend", "cross_section", "national",
              "municipal_comparison", "eu_harmonised", "oecd_harmonised",
              "global_harmonised", "custom"
            ]
          },
          "derived": {"type": "boolean"},
          "formula": {"type": "string", "minLength": 1},
          "depends_on": {
            "type": "array",
            "items": {"type": "string", "pattern": "^[a-z0-9-]+$"},
            "uniqueItems": true
          }
        },
        "allOf": [
          {
            "if": {"properties": {"derived": {"const": true}}},
            "then": {"required": ["formula", "depends_on"]}
          }
        ]
      }
    },
    "source_roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "need_id", "source_id", "role", "tier", "integration_status",
          "reason", "limitations"
        ],
        "properties": {
          "need_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "source_id": {"type": "string", "minLength": 1},
          "role": {"enum": ["primary", "supporting", "alternative", "excluded"]},
          "tier": {"enum": ["A", "B", "C", "D"]},
          "integration_status": {
            "enum": ["integrated", "catalog_only", "external"]
          },
          "reason": {"type": "string", "minLength": 1},
          "limitations": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "combination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "join_dimensions", "transformations", "risks"],
      "properties": {
        "required": {"type": "boolean"},
        "join_dimensions": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "transformations": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "risks": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "external_fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "reason", "search_target", "disclosure_required"],
      "properties": {
        "required": {"type": "boolean"},
        "reason": {"type": "string", "minLength": 1},
        "search_target": {"type": "string", "minLength": 1},
        "disclosure_required": {"type": "boolean"}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confidence", "review_reasons", "clarifications"],
      "properties": {
        "confidence": {"enum": ["high", "medium", "low"]},
        "review_reasons": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "clarifications": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "user_review_prompt": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {
        "properties": {"planning_mode": {"const": "review_before_execution"}}
      },
      "then": {"required": ["user_review_prompt"]}
    }
  ]
}
