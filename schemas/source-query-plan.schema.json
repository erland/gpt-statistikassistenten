{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://statistikassistenten.local/schemas/source-query-plan.schema.json",
  "title": "Source Query Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "question",
    "status",
    "sources",
    "steps",
    "decision"
  ],
  "properties": {
    "question": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "ready",
        "needs_clarification",
        "blocked"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "enum": [
          "scb",
          "eurostat",
          "comext",
          "bra",
          "kolada",
          "socialstyrelsen",
          "folkhalsodata",
          "arbetsformedlingen",
          "riksbank",
          "energimyndigheten",
          "forsakringskassan",
          "jordbruksverket",
          "skolverket",
          "smhi",
          "worldbank",
          "oecd",
          "who",
          "bis",
          "ecb",
        "euda",
        "tullverket"
        ]
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source",
          "purpose",
          "adapter"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "source": {
            "enum": [
              "scb",
              "eurostat",
              "comext",
              "bra",
              "kolada",
              "socialstyrelsen",
              "folkhalsodata",
              "arbetsformedlingen",
              "riksbank",
              "energimyndigheten",
              "forsakringskassan",
              "jordbruksverket",
              "skolverket",
              "smhi",
              "worldbank",
              "oecd",
              "who",
              "bis",
              "ecb",
            "euda",
            "tullverket"
            ]
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "adapter": {
            "type": "string",
            "minLength": 1
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "confidence"
      ],
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "ambiguities": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "clarification_question": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "needs_clarification"
          }
        }
      },
      "then": {
        "required": [
          "clarification_question"
        ]
      }
    }
  ]
}
