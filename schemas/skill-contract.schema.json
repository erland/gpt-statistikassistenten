{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canonical Skill Contract",
  "type": "object",
  "required": ["contract_version", "schema", "mode", "definitions"],
  "properties": {
    "contract_version": {"const": 1},
    "schema": {"type": "string", "minLength": 1},
    "mode": {"enum": ["explicit", "inferred"]},
    "definitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "description"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "minLength": 1, "maxLength": 64},
          "name": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1, "maxLength": 1024},
          "references": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "assets": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "scripts": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
