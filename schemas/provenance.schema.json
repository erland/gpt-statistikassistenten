{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://statistikassistenten.local/schemas/provenance.schema.json",
  "title": "Statistical Provenance",
  "type": "object",
  "additionalProperties": false,
  "required": ["source", "retrieval", "transformations"],
  "properties": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organization", "dataset_title"],
      "properties": {
        "organization": {"type": "string", "minLength": 1},
        "dataset_title": {"type": "string", "minLength": 1},
        "url": {"type": "string"},
        "license": {"type": "string"},
        "quality_assurance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_tier", "integration_status", "registry_quality_assured", "verified_for_this_answer"],
          "properties": {
            "source_tier": {"enum": ["A", "B", "C", "D"]},
            "integration_status": {"enum": ["integrated", "catalog_only", "external"]},
            "registry_quality_assured": {"type": "boolean"},
            "verified_for_this_answer": {"type": "boolean"},
            "disclosure": {"type": "string"}
          }
        },
        "source_identifiers": {
          "description": "Opaque provider-specific identifiers. They may be used for retrieval/provenance, never as analysis dimensions.",
          "type": "object",
          "additionalProperties": {"type": "string"}
        }
      }
    },
    "retrieval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["retrieved_at", "access_method"],
      "properties": {
        "retrieved_at": {"type": "string"},
        "access_method": {"enum": ["api", "file", "web_service", "manual"]},
        "metadata_verified": {"type": "boolean"},
        "query_summary": {"type": "string"}
      }
    },
    "transformations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operation"],
        "properties": {
          "operation": {"enum": ["none", "filter", "rename", "unit_conversion", "aggregation", "difference", "percent_change", "share", "per_capita", "index", "rank", "other"]},
          "description": {"type": "string"},
          "inputs": {"type": "array", "items": {"type": "string"}},
          "formula": {"type": "string"}
        }
      }
    }
  }
}
