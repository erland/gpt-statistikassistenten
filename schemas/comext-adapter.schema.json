{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://statistikassistenten.local/schemas/comext-adapter.schema.json",
  "title": "Comext trade query plan",
  "type": "object",
  "required": ["dataset_id", "reporter", "partner", "flow", "product", "period", "indicator"],
  "properties": {
    "dataset_id": {"type": "string", "pattern": "^DS-[A-Za-z0-9_-]+$"},
    "reporter": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "partner": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "flow": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "product": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "period": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "indicator": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "frequency": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "additionalProperties": false
}
