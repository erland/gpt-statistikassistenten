{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://statistikassistenten.local/schemas/scb-adapter.schema.json",
  "title": "SCB Adapter Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["source", "discovery", "metadata_gate", "data_request"],
  "properties": {
    "source": {"const": "scb_pxweb_v2"},
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["query", "language", "candidate_table_ids"],
      "properties": {
        "query": {"type": "string", "minLength": 1},
        "language": {"enum": ["sv", "en"]},
        "candidate_table_ids": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "metadata_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["table_id", "verified", "variables"],
      "properties": {
        "table_id": {"type": "string", "minLength": 1},
        "verified": {"const": true},
        "variables": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "semantic_kind", "selected_value_codes", "verified_from_metadata"],
            "properties": {
              "code": {"type": "string", "minLength": 1},
              "semantic_kind": {"enum": ["time", "geography", "classification", "population", "measure", "other"]},
              "selected_value_codes": {"type": "array", "items": {"type": "string"}, "minItems": 1},
              "codelist": {"type": ["string", "null"]},
              "mandatory": {"type": "boolean"},
              "verified_from_metadata": {"const": true}
            }
          }
        }
      }
    },
    "data_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "table_id", "selection", "output_format"],
      "properties": {
        "method": {"enum": ["GET", "POST"]},
        "table_id": {"type": "string", "minLength": 1},
        "selection": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["variableCode", "valueCodes"],
            "properties": {
              "variableCode": {"type": "string", "minLength": 1},
              "valueCodes": {"type": "array", "items": {"type": "string"}, "minItems": 1},
              "codelist": {"type": ["string", "null"]}
            }
          }
        },
        "output_format": {"enum": ["json-stat2", "csv", "xlsx"]},
        "estimated_cells": {"type": "integer", "minimum": 1, "maximum": 150000}
      }
    }
  }
}
